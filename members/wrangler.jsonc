{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnivalsociety-members",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnivalsociety-members",
      "database_id": "2c2774f0-7494-4b4c-a176-6eb8f7230c38"
    }
  ],
  // Per-IP throttle for signup/signin/forgot/reset (rateLimited() in worker.js).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  // Hourly: event reminders; housekeeping once a day (scheduled() in worker.js).
  "triggers": { "crons": ["17 * * * *"] },
  // Secrets (wrangler secret put): RESEND_API_KEY, TURNSTILE_SECRET,
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET. Each feature stays off until set.
  "vars": {
    "EMAIL_FROM": "Carnival Society <hello@carnivalsociety.org>",
    // Web push (the raven on your phone). Private half is the secret VAPID_PRIVATE_JWK.
    "VAPID_PUBLIC_KEY": "BFHZ83VjqhFgrixwzBD8FxcoXqy-0jmluqWrzVDjvbxOTpnDJPkt_mnUfo4jBO_4-rnWhdpVohjul_GAbzflCL4"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "members.carnivalsociety.org", "custom_domain": true }
  ]
}
